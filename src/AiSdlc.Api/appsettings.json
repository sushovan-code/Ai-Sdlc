{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/aisdlc.db"
  },
  "Jwt": {
    "Issuer": "aisdlc-api",
    "Audience": "aisdlc-web",
    "AccessTokenMinutes": 60
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
