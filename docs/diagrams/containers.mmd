%% Container view. Claude rewrites this from the code via /update-diagrams.
%% Accent (#2563EB) marks this system's own containers; grey is everything else.
flowchart LR
  classDef ours fill:#DBEAFE,stroke:#2563EB,color:#0F172A
  classDef ext fill:#F1F5F9,stroke:#94A3B8,color:#334155,stroke-dasharray:4 3

  user([User])
  web[Web app<br/><small>Angular SPA</small>]:::ours
  api[API<br/><small>.NET 10 Minimal API, Identity + JWT</small>]:::ours
  db[(SQLite<br/><small>EF Core</small>)]:::ours
  files[(File storage<br/><small>local disk, IFileStorage</small>)]:::ours
  ai[OpenAI<br/><small>gpt-5.4-mini via IChatClient</small>]:::ext

  user --> web
  web -->|HTTPS, JSON, JWT| api
  api --> db
  api --> files
  api -->|prompts, responses| ai

  subgraph Legend
    direction LR
    l1[This system]:::ours
    l2[External]:::ext
  end
